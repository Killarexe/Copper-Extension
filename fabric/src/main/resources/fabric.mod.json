{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/right-click-chest-boat",
        "sources": "https://github.com/Killarexe/Right-Click-Chest-Boat"
    },
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "github.killarexe.copper_extension.fabric.CEFabric"
        ],
        "fabric-datagen": [
            "github.killarexe.copper_extension.fabric.generation.data.CEDataGenerator"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">26",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  